NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional legacy fallback for older Supabase projects
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_BASE_URL=https://mergen-ai.com
ADMIN_EMAIL=admin@mergen-ai.com
# Server-only: Perplexity researches and creates surveys.
PERPLEXITY_API_KEY=
# Server-only: Gemini evaluates answers, trust scores, and response reports.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RESEND_API_KEY=your_resend_api_key
CONTACT_TO_EMAIL=team@mergen-ai.com
# Optional legacy fallback for contact inbox routing
TO_EMAIL=
RESEND_FROM_EMAIL=MERGEN AI <hello@mergen-ai.com>
CRON_SECRET=replace_with_a_long_random_secret
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_telegram_bot_username
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret
POLAR_ACCESS_TOKEN=your_polar_access_token
POLAR_SURVEY_PRODUCT_ID=your_polar_one_time_product_id
POLAR_SERVER=production

# Optional immutable admin allowlist. When set, this takes precedence over ADMIN_EMAIL(S).
ADMIN_USER_IDS=
# Polar endpoint signing secret; configure checkout.updated, order.paid, order.refunded.
POLAR_WEBHOOK_SECRET=
# Development only; still requires a real authorized admin session.
ENABLE_LOCAL_ADMIN_PREVIEW=false

# Production catalog access. Requires Tremendous business/API approval; PROD_ key only.
# Gift redemption remains disabled pending approved products, pricing and fulfillment.
TREMENDOUS_MODE=production
TREMENDOUS_API_KEY=
# Separate TEST_ key for explicitly selected sandbox development.
TREMENDOUS_SANDBOX_API_KEY=

# Trolley keys stay server-side. Sandbox credentials cannot activate member withdrawals.
TROLLEY_MODE=live
TROLLEY_SANDBOX_ACCESS_KEY=
TROLLEY_SANDBOX_SECRET_KEY=
TROLLEY_LIVE_ACCESS_KEY=
TROLLEY_LIVE_SECRET_KEY=
TROLLEY_LIVE_WEBHOOK_SECRET=
TROLLEY_WITHDRAWALS_ENABLED=false
# Enable only reviewed ISO country codes with suitable bank routes/minimums, e.g. AZ,US.
TROLLEY_ALLOWED_COUNTRIES=
